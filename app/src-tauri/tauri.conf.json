{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exif Cleaner PSD",
  "identifier": "vn.abeee.exif-cleaner-psd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Exif Cleaner PSD",
        "width": 1180,
        "height": 720,
        "minWidth": 860,
        "minHeight": 520,
        "dragDropEnabled": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "aBeee",
    "shortDescription": "Remove photoshop:DocumentAncestors from PSD/PSB files and their smart objects"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NDIwNzFENzRFMjAyQUIKUldTckF1SjBIUWRDbVowbk9VUjlYUXJMZ2k2Nk1ZSkJTelhIL1hVMlZCc2M0ck1QYURhRUZmSjgK",
      "endpoints": ["https://github.com/paquoc/exif-cleaner-cli/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "mainBinaryName": "exif-cleaner-psd"
}